{
  "info": {
    "name": "Sera AI Chatbot REST Contract",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{privyAccessToken}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/v1/health",
        "auth": { "type": "noauth" }
      },
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["pm.response.to.have.status(200);"] }
        }
      ]
    },
    {
      "name": "Capabilities",
      "request": { "method": "GET", "url": "{{baseUrl}}/v1/capabilities" },
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["pm.response.to.have.status(200);"] }
        }
      ]
    },
    {
      "name": "My Wallet",
      "request": { "method": "GET", "url": "{{baseUrl}}/v1/wallets/me" },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.expect(pm.response.code).to.be.oneOf([200, 401, 404]);"
            ]
          }
        }
      ]
    }
  ]
}
